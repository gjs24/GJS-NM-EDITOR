# ==============================================================================
# GJS Railway Board Studio · Render Backend Environment Configuration
# ==============================================================================
# Set these in your Render Dashboard under:
# Web Service > Environment > Add Environment Variable

PORT=5000
NODE_ENV=production

# Frontend Origin for CORS (Vercel URL)
# Example: https://gjs-railway-studio.vercel.app or * for all during testing
FRONTEND_URL="*"

# Supabase PostgreSQL Configuration
# Get these from Supabase Dashboard > Project Settings > API
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Cashfree Payments Production Configuration
# Get these from Cashfree Merchant Dashboard > Payment Gateway > Developers > API Keys
CASHFREE_APP_ID="TEST_CF_APP_GJS_94821"
CASHFREE_SECRET_KEY="TEST_CF_SECRET_SECURED"
CASHFREE_ENV="sandbox"
# When ready for live production, change to:
# CASHFREE_ENV="production"
# CASHFREE_APP_ID="your_live_app_id"
# CASHFREE_SECRET_KEY="your_live_secret_key"

# Admin Authentication Passcode
ADMIN_PASSCODE="admin123"

