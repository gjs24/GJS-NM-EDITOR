# ==============================================================================
# GJS Railway Name Board Studio · Production Environment Configuration
# ==============================================================================
# Copy this file to `.env` or set these environment variables in your hosting
# provider dashboard (Vercel, Netlify, Cloudflare Pages, Docker, or Linux VPS).
# Note: All variables exposed to the client in Vite must be prefixed with `VITE_`.

# Application Branding & Title
VITE_APP_TITLE="GJS Railway Name Board Studio"

# Admin Access Passcode
# Change this from the default 'admin123' to a strong secret passcode in production!
VITE_ADMIN_PASSCODE="admin123"

# Cashfree Payments Gateway Credentials
# For Sandbox Testing:
#   VITE_CASHFREE_ENV="sandbox"
#   VITE_CASHFREE_APP_ID="TEST_CF_APP_GJS_94821"
#   VITE_CASHFREE_SECRET_KEY="TEST_CF_SECRET_SECURED"
#
# For Live Production (After Cashfree Merchant Account Activation):
#   VITE_CASHFREE_ENV="production"
#   VITE_CASHFREE_APP_ID="your_live_cashfree_app_id"
#   VITE_CASHFREE_SECRET_KEY="your_live_cashfree_secret_key"
VITE_CASHFREE_ENV="sandbox"
VITE_CASHFREE_APP_ID="TEST_CF_APP_GJS_94821"
VITE_CASHFREE_SECRET_KEY="TEST_CF_SECRET_SECURED"

# Google OAuth Client ID (Optional for Google Sign-In)
# Get this from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized JavaScript Origins: https://yourdomain.com
VITE_GOOGLE_CLIENT_ID=""

# Base Path
# Default is './' for maximum compatibility (supports subdirectories, Electron, and root domains).
# If deploying to a specific root domain, you can set '/' or '/subfolder/'
VITE_BASE_PATH="./"

# Render Backend API URL (Connected to Supabase)
# Set this in your Vercel Dashboard to point to your Render backend web service
# Example: https://gjs-railway-backend.onrender.com
VITE_API_BASE_URL=""

